# All Jmeet keys. Copy the block you need into .env, then run npm run config
# to write public/config.js. Never commit .env.
# GOOGLE_CLIENT_ID, GitHub and TURN values reach the browser through
# config.js; GITHUB_CLIENT_SECRET stays in the gateway (scripts/gateway.js).
# GOOGLE_CLIENT_SECRET is kept for a server-side Google flow; the Sign in with
# Google popup doesn't need it, so nothing reads it yet.

# ===== Local =====
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
APP_URL=http://localhost:8001
GITHUB_CALLBACK_URL=http://localhost:8001/auth/github/callback
TURN_URLS=YOUR_TURN_URLS
TURN_USERNAME=YOUR_TURN_USERNAME
TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

# ===== Development =====
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
APP_URL=https://YOUR_FIXED_TUNNEL_HOSTNAME
GITHUB_CALLBACK_URL=https://YOUR_FIXED_TUNNEL_HOSTNAME/auth/github/callback
TURN_URLS=YOUR_TURN_URLS
TURN_USERNAME=YOUR_TURN_USERNAME
TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

# ===== Production =====
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
APP_URL=https://YOUR_DOMAIN
GITHUB_CALLBACK_URL=https://YOUR_DOMAIN/auth/github/callback
TURN_URLS=YOUR_TURN_URLS
TURN_USERNAME=YOUR_TURN_USERNAME
TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL
