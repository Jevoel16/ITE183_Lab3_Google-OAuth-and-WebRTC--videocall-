# GitHub sign-in helper (scripts/github-auth.js, npm run auth).
# Copy the block you need into .env. Never commit .env.

# ===== Local =====
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
APP_URL=http://localhost:8000
GITHUB_CALLBACK_URL=http://localhost:8002/auth/github/callback

# ===== Development =====
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
APP_URL=https://YOUR_FIXED_TUNNEL_HOSTNAME
GITHUB_CALLBACK_URL=https://YOUR_FIXED_TUNNEL_HOSTNAME/auth/github/callback

# ===== Production =====
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
APP_URL=https://YOUR_DOMAIN
GITHUB_CALLBACK_URL=https://YOUR_DOMAIN/auth/github/callback
