include("lib/http.bzg");
include("config.bzg");

// Cloudflare serves HTTPS in tunnel mode, so the app listens on plain HTTP
var port = 443;
if (useTunnel == 1) {
    port = tunnelPort;
}
var server = http(port, 16, 8, 0, 16);
var maxParticipants = 8;
var participantSessions = [null, null, null, null, null, null, null, null];
var participantInfo = [null, null, null, null, null, null, null, null];
// Room code per client; null until it sends {kind: "join", room}
var participantRooms = [null, null, null, null, null, null, null, null];
var roomLetters = "abcdefghijklmnopqrstuvwxyz";

function isSuccess(response) {
    if (response == null) {
        return false;
    }
    return substr(response, 0, 5) == "HTTP/" && substr(response, 9, 3) == "200";
}

function finishLogin(tokenUrl, clientId, clientSecret, redirectUri, profileUrl) {
    if (server.oauthValidateState() != 1) {
        server.sendResponse("Invalid or expired OAuth state.", "text/plain", 400);
        return;
    }
    var code = server.getQuery("code");
    if (code == null) {
        server.sendResponse("Authorization was denied or no code was returned.", "text/plain", 400);
        return;
    }
    var response = server.oauthExchangeCode(tokenUrl, clientId, clientSecret, redirectUri, code);
    if (!isSuccess(response)) {
        server.sendResponse("Could not exchange the authorization code.", "text/plain", 502);
        return;
    }
    var token = server.oauthGetAccessToken(server.getResponseBody(response));
    if (token == null) {
        server.sendResponse("The provider did not return an access token.", "text/plain", 502);
        return;
    }
    var headers = "Authorization: Bearer " + token + "\r\nAccept: application/json\r\n";
    var profileResponse = server.requestGET(profileUrl, headers);
    if (!isSuccess(profileResponse)) {
        server.sendResponse("Could not retrieve the provider profile.", "text/plain", 502);
        return;
    }
    var sessionId = server.oauthSessionCreate(server.getResponseBody(profileResponse));
    if (sessionId == null) {
        server.sendResponse("The profile was invalid or the session store is full.", "text/plain", 503);
        return;
    }
    server.oauthSessionClear();
    server.addHeader("Set-Cookie: bsl_session=" + sessionId +
        "; Path=/; Max-Age=3600; HttpOnly; Secure; SameSite=Lax");
    server.redirect("/");
}

function isLetter(ch) {
    for (var j = 0; j < 26; j = j + 1) {
        if (substr(roomLetters, j, 1) == ch) {
            return true;
        }
    }
    return false;
}

// BSL's regex has no character classes, so abc-defg-hij is checked by hand
function isRoomCode(room) {
    if (room.type != "string" || room.size != 12) {
        return false;
    }
    for (var i = 0; i < 12; i = i + 1) {
        var ch = substr(room, i, 1);
        if (i == 3 || i == 8) {
            if (ch != "-") {
                return false;
            }
        } else if (!isLetter(ch)) {
            return false;
        }
    }
    return true;
}

function sendToRoom(room, message, skipId) {
    for (var i = 0; i < maxParticipants; i = i + 1) {
        if (i != skipId && participantRooms[i] == room) {
            server.send(i, message);
        }
    }
}

function removePeer(clientId) {
    if (participantSessions[clientId] != null) {
        var room = participantRooms[clientId];
        participantSessions[clientId] = null;
        participantInfo[clientId] = null;
        participantRooms[clientId] = null;
        if (room != null) {
            sendToRoom(room, stringifyJSON({kind: "left", id: clientId}), clientId);
        }
    }
}

function profileField(profile, key) {
    // Missing object properties raise runtime errors in BSL.
    if (regex("\"" + key + "\":", stringifyJSON(profile)) == "") {
        return null;
    }
    try {
        return profile[key];
    } catch (error) {
        return null;
    }
}

server.get = function (path, request) {
    server.addHeader("Cache-Control: no-store");
    if (path == "/") {
        server.sendFile("public/index.html");
    } else if (path == "/style.css") {
        server.sendFile("public/style.css");
    } else if (path == "/jmeet-core.js") {
        server.sendFile("public/jmeet-core.js");
    } else if (path == "/login/google") {
        if (server.oauthStart("https://accounts.google.com/o/oauth2/v2/auth",
            googleClientId, googleRedirectUri, "openid email profile") != 1) {
            server.sendResponse("Could not start Google login.", "text/plain", 500);
        }
    } else if (path == "/login/github") {
        if (server.oauthStart("https://github.com/login/oauth/authorize",
            githubClientId, githubRedirectUri, "read:user") != 1) {
            server.sendResponse("Could not start GitHub login.", "text/plain", 500);
        }
    } else if (path == "/google-callback") {
        finishLogin("https://oauth2.googleapis.com/token", googleClientId,
            googleClientSecret, googleRedirectUri, "https://openidconnect.googleapis.com/v1/userinfo");
    } else if (path == "/github-callback") {
        finishLogin("https://github.com/login/oauth/access_token", githubClientId,
            githubClientSecret, githubRedirectUri, "https://api.github.com/user");
    } else if (path == "/api/me") {
        var profile = server.oauthSessionGet();
        if (profile == null) {
            server.sendResponse("Sign in required.", "text/plain", 401);
        } else {
            server.sendResponse(profile, "application/json", 200);
        }
    } else {
        server.sendFile("public/404.html");
    }
     gc();
};

server.post = function (path, request) {
    server.addHeader("Cache-Control: no-store");
    if (path == "/logout") {
        if (server.getHeader("Origin") != baseUrl) {
            server.sendResponse("Invalid request origin.", "text/plain", 403);
        } else {
            var sessionId = server.getCookie("bsl_session");
            if (sessionId != null) {
                for (var i = 0; i < maxParticipants; i = i + 1) {
                    if (participantSessions[i] == sessionId) {
                        removePeer(i);
                        server.close(i);
                    }
                }
            }
            server.oauthSessionClear();
            server.addHeader("Set-Cookie: bsl_session=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax");
            server.sendResponse("Signed out.", "text/plain", 200);
        }
    } else {
        server.sendResponse("Not found.", "text/plain", 404);
    }

     gc();
};

server.onConnect = function (clientId, path) {
    var profileJson = server.oauthSessionGet();
    if (path != "/signal" || server.getHeader("Origin") != baseUrl || profileJson == null) {
        server.close(clientId);
    } else {
        var profile = parseJSON(profileJson);
        var name = profileField(profile, "name");
        if (name.type != "string" || name == "") {
            name = profileField(profile, "login");
        }
        if (name.type != "string" || name == "") {
            name = "Participant";
        }
        var picture = profileField(profile, "picture");
        if (picture.type != "string") {
            picture = profileField(profile, "avatar_url");
        }
        if (picture.type != "string") {
            picture = "";
        }
        participantSessions[clientId] = server.getCookie("bsl_session");
        participantInfo[clientId] = {name: name, picture: picture};
        participantRooms[clientId] = null;
    }
     gc();
};

server.onData = function (message, clientId) {
    if (participantSessions[clientId] != null) {
        var incoming = parseJSON(message);
        if (incoming.type != "object") {
            return;
        }
        var kind = profileField(incoming, "kind");
        var room = participantRooms[clientId];
        if (kind == "join") {
            var requested = profileField(incoming, "room");
            if (room == null && isRoomCode(requested)) {
                participantRooms[clientId] = requested;
                server.send(clientId, stringifyJSON({kind: "self", id: clientId, room: requested, user: participantInfo[clientId]}));
                for (var i = 0; i < maxParticipants; i = i + 1) {
                    if (i != clientId && participantRooms[i] == requested) {
                        server.send(clientId, stringifyJSON({kind: "existing", id: i, user: participantInfo[i]}));
                        server.send(i, stringifyJSON({kind: "joined", id: clientId, user: participantInfo[clientId]}));
                    }
                }
            }
        } else if (room == null || kind == "ping") {
            // Not in a room yet, or a heartbeat that only keeps Cloudflare from closing the socket
        } else if (kind == "signal") {
            var target = profileField(incoming, "target");
            var data = profileField(incoming, "data");
            if (target.type == "number" && target >= 0 && target < maxParticipants &&
                int(target) == target && target != clientId && participantRooms[target] == room &&
                data.type == "object") {
                server.send(target, stringifyJSON({kind: "signal", from: clientId, data: data}));
            }
        } else if (kind == "chat") {
            var text = profileField(incoming, "text");
            if (text.type == "string" && text.size > 0 && text.size <= 1000) {
                sendToRoom(room, stringifyJSON({kind: "chat", from: clientId, text: text}), -1);
            }
        } else if (kind == "media") {
            // Mic/camera state (1 on, 0 off) so other tiles can show a muted badge
            var audio = profileField(incoming, "audio");
            var video = profileField(incoming, "video");
            if (audio.type == "number" && video.type == "number" && (audio == 0 || audio == 1) && (video == 0 || video == 1)) {
                sendToRoom(room, stringifyJSON({kind: "media", from: clientId, audio: audio, video: video}), clientId);
            }
        }
    }
     gc();
};

server.onDisconnect = function (clientId) {
    removePeer(clientId);
    gc();
};

if (useTunnel == 1) {
    print("Listening on http://localhost:" + port + " behind tunnel-proxy on 8001");
    print("Open " + baseUrl);
    server.run();
} else if (server.enableTLS(certificatePath, privateKeyPath) == -1) {
    print("TLS setup failed; the video call server was not started.");
} else {
    print("Open " + baseUrl);
    server.run();
}
