var googleClientId = "YOUR_GOOGLE_CLIENT_ID";
var googleClientSecret = "YOUR_GOOGLE_CLIENT_SECRET";
var githubClientId = "YOUR_GITHUB_CLIENT_ID";
var githubClientSecret = "YOUR_GITHUB_CLIENT_SECRET";

// 1 = Cloudflare quick tunnel (plain HTTP on tunnelPort), 0 = local HTTPS on 443 with cert/
var useTunnel = 1;
// scripts/tunnel-proxy.js listens on 8001 for cloudflared and forwards here
var tunnelPort = 8002;

// Paste the address cloudflared prints. Local HTTPS uses https://localhost instead.
var baseUrl = "https://YOUR-TUNNEL.trycloudflare.com";
var googleRedirectUri = "https://YOUR-TUNNEL.trycloudflare.com/google-callback";
var githubRedirectUri = "https://YOUR-TUNNEL.trycloudflare.com/github-callback";

// Only read when useTunnel = 0
var certificatePath = "cert/cert.pem";
var privateKeyPath = "cert/key.pem";
