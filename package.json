{
  "name": "ite183-lab3-google-oauth-webrtc",
  "version": "1.2.1",
  "description": "Jmeet: Google and GitHub OAuth sign-in and WebRTC group video calls on a Bonezegei HTTPS server",
  "main": "app.bzg",
  "scripts": {
    "start": "bonezegei app.bzg",
    "test": "node scripts/check-syntax.js && node --test \"scripts/*.test.js\"",
    "online": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/online.ps1",
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1",
    "local:linux": "bash scripts/run.sh local",
    "online:linux": "bash scripts/run.sh online"
  },
  "dependencies": {
    "http": "^1.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=26"
  }
}
